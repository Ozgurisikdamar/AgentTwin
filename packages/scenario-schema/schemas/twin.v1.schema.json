{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenttwin.dev/schemas/twin.v1.schema.json",
  "title": "AgentTwin TwinDefinition v1 (declarative stateful tool twin)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "const": "agenttwin.dev/v1"
    },
    "kind": {
      "const": "TwinDefinition"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$"
        },
        "description": {
          "type": "string",
          "maxLength": 2000
        },
        "source": {
          "enum": [
            "declarative",
            "openapi",
            "mcp",
            "recorded",
            "custom"
          ]
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tools"
      ],
      "properties": {
        "secrets": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 4
          },
          "description": "Planted secret values that must never appear in agent output or tool arguments."
        },
        "tenantKey": {
          "type": "string",
          "description": "Entity field holding the owning tenant (cross-tenant detection)."
        },
        "tools": {
          "type": "object",
          "maxProperties": 500,
          "additionalProperties": {
            "$ref": "#/$defs/tool"
          },
          "propertyNames": {
            "pattern": "^[A-Za-z0-9_.-]{1,100}$"
          }
        },
        "initialState": {
          "type": "object",
          "description": "The twin's default state; a scenario's spec.state is applied on top as a JSON Merge Patch (RFC 7396)."
        },
        "retrieval": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "statePath": {
              "type": "string",
              "maxLength": 500,
              "description": "State path of the knowledge-base documents served at /kb/search (default: kb)."
            }
          }
        }
      }
    }
  },
  "$defs": {
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "exists": {
          "type": "boolean"
        },
        "equals": {},
        "notEquals": {},
        "in": {
          "type": "array"
        },
        "gte": {},
        "lte": {},
        "gt": {},
        "lt": {},
        "error": {
          "$ref": "#/$defs/error"
        }
      }
    },
    "effect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op",
        "path"
      ],
      "properties": {
        "op": {
          "enum": [
            "set",
            "increment",
            "decrement",
            "append",
            "delete",
            "merge"
          ]
        },
        "path": {
          "type": "string"
        },
        "value": {
          "description": "Value for set/append/merge; strings may be templates."
        },
        "by": {
          "type": [
            "number",
            "string"
          ],
          "description": "Amount for increment/decrement (default 1); may be a template such as \"{amount}\"."
        }
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "handler"
      ],
      "properties": {
        "description": {
          "type": "string",
          "maxLength": 4000
        },
        "risk": {
          "enum": [
            "READ",
            "WRITE_REVERSIBLE",
            "WRITE_IRREVERSIBLE",
            "EXECUTE",
            "ADMIN"
          ]
        },
        "inputSchema": {
          "type": "object"
        },
        "outputSchema": {
          "type": "object"
        },
        "idempotency": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "argument": {
              "type": "string"
            },
            "header": {
              "type": "string"
            }
          }
        },
        "effectKey": {
          "type": "string",
          "description": "Template identifying the logical side effect (duplicate detection), e.g. 'refund:{order_id}'."
        },
        "tenantPath": {
          "type": "string",
          "description": "Template path of the entity whose tenant is checked, e.g. 'customers.{customer_id}'."
        },
        "handler": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "enum": [
                "read",
                "mutate",
                "static",
                "echo",
                "recorded",
                "custom"
              ]
            },
            "path": {
              "type": "string"
            },
            "notFound": {
              "$ref": "#/$defs/error"
            },
            "preconditions": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/condition"
              }
            },
            "effects": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/effect"
              }
            },
            "response": {
              "type": "object"
            },
            "fixtures": {
              "type": "array",
              "maxItems": 500,
              "items": {
                "$ref": "#/$defs/fixture"
              }
            },
            "adapter": {
              "type": "string"
            }
          }
        }
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "match": {
          "type": "object",
          "description": "Arguments that must be present with these values."
        },
        "status": {
          "type": "integer",
          "minimum": 200,
          "maximum": 599
        },
        "response": {},
        "error": {
          "$ref": "#/$defs/error"
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "code"
      ],
      "properties": {
        "status": {
          "type": "integer",
          "minimum": 400,
          "maximum": 599
        },
        "code": {
          "type": "string",
          "maxLength": 100
        },
        "message": {
          "type": "string",
          "maxLength": 1000
        }
      }
    }
  }
}
