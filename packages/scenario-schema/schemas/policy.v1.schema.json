{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenttwin.dev/schemas/policy.v1.schema.json",
  "title": "AgentTwin runtime Policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "agenttwin.dev/v1"},
    "kind": {"const": "Policy"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$"},
        "description": {"type": "string", "maxLength": 2000}
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "rules"],
      "properties": {
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tool"],
          "properties": {
            "tool": {"type": "string", "minLength": 1, "maxLength": 100, "description": "Tool name or '*' for all tools."},
            "agents": {"type": "array", "items": {"type": "string"}},
            "environments": {"type": "array", "items": {"type": "string"}}
          }
        },
        "failMode": {"enum": ["closed", "open", "require_approval"], "default": "closed"},
        "defaultEffect": {"enum": ["allow", "deny", "require_approval"], "default": "allow"},
        "rules": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "when", "effect"],
            "properties": {
              "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$"},
              "when": {"type": "string", "minLength": 1, "maxLength": 4000, "description": "CEL boolean expression over args, tool, agent, environment, trace, risk."},
              "effect": {"enum": ["allow", "allow_with_limits", "require_approval", "deny"]},
              "message": {"type": "string", "maxLength": 1000},
              "category": {"type": "string", "maxLength": 64},
              "limits": {"$ref": "#/$defs/limits"}
            }
          }
        },
        "limits": {"$ref": "#/$defs/limits"},
        "approval": {
          "type": "object",
          "additionalProperties": false,
          "properties": {"ttlSeconds": {"type": "integer", "minimum": 30, "maximum": 86400}}
        },
        "fixtures": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "input", "expect"],
            "properties": {
              "name": {"type": "string", "maxLength": 200},
              "input": {"type": "object"},
              "expect": {"enum": ["allow", "allow_with_limits", "require_approval", "deny"]}
            }
          }
        }
      }
    }
  },
  "$defs": {
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "timeoutMs": {"type": "integer", "minimum": 1, "maximum": 120000},
        "maxResponseBytes": {"type": "integer", "minimum": 1, "maximum": 52428800}
      }
    }
  }
}
