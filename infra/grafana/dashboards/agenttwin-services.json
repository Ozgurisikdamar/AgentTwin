      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "topk(10, histogram_quantile(0.95, sum by (service, route, le) (rate(agenttwin_http_request_duration_seconds_bucket{route!~\".*(health|metrics).*|/twin/.*\"}[1h]))))",
          "format": "table",
          "instant": true,
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "title": "Slowest routes (p95, last hour)",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true
            }
          }
        }
      ],
      "type": "table"
    },
