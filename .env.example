# AgentTwin local configuration. Copy to .env: `cp .env.example .env`.
# Values prefixed "change-me" are development placeholders; services refuse
# to start with them when APP_ENV=production.

APP_ENV=development
LOG_LEVEL=info

# --- Authentication (ADR-0009) ---------------------------------------------
# dev  : local login with seeded demo users (never allowed in production)
# oidc : validate tokens from any OIDC provider (Keycloak, Entra ID, Okta)
AUTH_MODE=dev
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
AGENTTWIN_SESSION_SECRET=change-me-dev-session-secret-0123456789abcdef
AGENTTWIN_INTERNAL_TOKEN_SECRET=change-me-dev-internal-token-secret-0123456789
AGENTTWIN_API_KEY_PEPPER=change-me-dev-api-key-pepper-0123456789abcdef
# Deterministic demo API key used by the demo agent to export traces and call
# the runtime gateway (created by `make seed`; development only).
AGENTTWIN_DEMO_API_KEY=atk_demo0000_change-me-demo-secret-0123456789abcdef
# Tokens protecting the demo agent adapter and the demo tools' admin API.
DEMO_AGENT_TOKEN=change-me-demo-agent-token
DEMO_TOOLS_ADMIN_TOKEN=change-me-demo-tools-admin-token
# Conversations sent by `make seed` (each run adds a batch).
SEED_TRAFFIC_COUNT=40
# Agent versions whose scenario suite `make seed` simulates (empty: none).
SEED_SIMULATE_VERSIONS=1.2.4,1.3.0
# BASELINE:CANDIDATE that `make seed` evaluates on the regression suite
# dataset (empty: none).
SEED_EVALUATE=1.2.4:1.3.0
# Simulation runs one worker executes at a time.
SIMULATION_WORKER_CONCURRENCY=2

# --- Infrastructure ---------------------------------------------------------
POSTGRES_USER=agenttwin
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=agenttwin
POSTGRES_HOST_PORT=55432
RABBITMQ_USER=agenttwin
RABBITMQ_PASSWORD=change-me-rabbitmq-password
RABBITMQ_HOST_PORT=5672
RABBITMQ_UI_HOST_PORT=15672
GRAFANA_ADMIN_PASSWORD=change-me-grafana-password

# --- Ports exposed on the host ----------------------------------------------
WEB_HOST_PORT=3000
CONTROL_PLANE_HOST_PORT=8080
RUNTIME_GATEWAY_HOST_PORT=8086
OTEL_GRPC_HOST_PORT=4317
OTEL_HTTP_HOST_PORT=4318
PROMETHEUS_HOST_PORT=9090
GRAFANA_HOST_PORT=3001
DEMO_AGENT_HOST_PORT=8090
DEMO_TOOLS_HOST_PORT=8091

# --- Model providers (optional; CI and the demo use deterministic fakes) ----
# The judge of semantic expectations (ADR-0022): fake (deterministic lexical
# judge, not a model) | anthropic | openai (any OpenAI-compatible endpoint,
# JUDGE_BASE_URL). A real judge needs JUDGE_MODEL and JUDGE_API_KEY.
JUDGE_PROVIDER=fake
JUDGE_MODEL=
JUDGE_API_KEY=
JUDGE_BASE_URL=
# What one evaluation run may spend on judging (USD; "none": calls only).
EVALUATION_JUDGE_BUDGET_USD=5
# The demo agent's model key (DEMO_AGENT_MODEL=anthropic).
ANTHROPIC_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
# hashing (local, lexical) | openai_compatible
EMBEDDING_PROVIDER=hashing
EMBEDDING_MODEL=
# Demo agent model: scripted (deterministic fake) | anthropic
DEMO_AGENT_MODEL=scripted
DEMO_AGENT_ANTHROPIC_MODEL=claude-sonnet-5
